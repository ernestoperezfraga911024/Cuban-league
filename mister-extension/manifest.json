{
  "manifest_version": 3,
  "name": "Cuban League · Importar desde Mister",
  "version": "1.1.1",
  "description": "Importa jornadas de Primera y la clasificación general de Segunda. Revisión y publicación desde el panel.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Importar desde Mister"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ernestoperezfraga911024.github.io/Cuban-league/admin.html*"
      ],
      "js": [
        "admin-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://mister.mundodeportivo.com/*"
      ],
      "js": [
        "mister-import-core.js",
        "collector.js",
        "second-division-core.js",
        "second-division-collector.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
